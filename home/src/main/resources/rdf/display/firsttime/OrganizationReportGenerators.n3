:OrganizationLabelDistributor
        a              <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
        :actionName    "Reports: organization label" ;
        :query         """
	PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
	PREFIX foaf: <http://xmlns.com/foaf/0.1/>
	SELECT ?label ?currentYear
	WHERE {
	  BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
	  ?organization a foaf:Organization .
	  ?organization rdfs:label ?label .
	  BIND (YEAR(NOW()) as ?currentYear)
	}
	""" ;
        :uriBinding    "uri" ;
        :resultFormat  "JSON" .

:PublicationsOverLast5YearsDistributor
        a              <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
        :actionName    "Collaboration report: publications over the last 5 years" ;
        :query         """
PREFIX bibo: <http://purl.org/ontology/bibo/>
PREFIX vivo: <http://vivoweb.org/ontology/core#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
SELECT (COUNT(?publicationExt) as ?publicationExtCount) (COUNT(?publicationInt) as ?publicationIntCount) ?year
WHERE {
  SELECT DISTINCT ?publicationInt ?year ?publicationExt
  WHERE {
    {
      SELECT ?year WHERE {
        {
          BIND (YEAR(NOW()) as ?currentYear)
          BIND(?currentYear as ?year) 
        }
        UNION
        {
          BIND (YEAR(NOW()) as ?currentYear)
          BIND(?currentYear -1 as ?year) 
        }
        UNION
        {
          BIND (YEAR(NOW()) as ?currentYear)
          BIND(?currentYear -2 as ?year) 
        }
        UNION
        {
          BIND (YEAR(NOW()) as ?currentYear)
          BIND(?currentYear -3 as ?year) 
        }
        UNION
        {
          BIND (YEAR(NOW()) as ?currentYear)
          BIND(?currentYear -4 as ?year) 
        }
      }
    }
    OPTIONAL {
    BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
    ?organization a foaf:Organization .
    ?organization obo:BFO_0000051*/vivo:relatedBy ?position1 .
    ?position1 vivo:relates ?person1 .
    ?person1 a foaf:Person .
    ?person1 vivo:relatedBy/vivo:relates ?publication .
    VALUES ?publicationType { bibo:Document bibo:Journal }
    ?publication vivo:dateTimeValue/vivo:dateTime ?publicationDT .
    FILTER(?year = YEAR(?publicationDT))
    OPTIONAL {
      ?position1 vivo:dateTimeInterval ?dti1 .
      ?dti1 vivo:start/vivo:dateTime ?position1StartDT .
      OPTIONAL {
        ?dti1 vivo:end/vivo:dateTime ?position1EndDT .
      }
    }
    FILTER(!BOUND(?position1StartDT) || ?position1StartDT <= ?publicationDT)
    FILTER(!BOUND(?position1EndDT) || ?position1EndDT >= ?publicationDT)
    ?person2 vivo:relatedBy/vivo:relates ?publication .
    ?person2 a foaf:Person .
    FILTER(?person1 != ?person2)
    ?position2 vivo:relates ?person2 .
    ?position2 a vivo:Position .
    ?publication a ?publicationType .
    OPTIONAL {
      ?position2 vivo:dateTimeInterval ?dti2 .
      ?dti2 vivo:start/vivo:dateTime ?position2StartDT .
      OPTIONAL {
        ?dti2 vivo:end/vivo:dateTime ?position2EndDT .
      }
    }
    FILTER(!BOUND(?position2StartDT) || ?position2StartDT <= ?publicationDT)
    FILTER(!BOUND(?position2EndDT) || ?position2EndDT >= ?publicationDT)
    BIND(IF(EXISTS {
          ?organization obo:BFO_0000051*/vivo:relatedBy ?position2 
        }, 1/0, ?publication ) as ?publicationInt ) 
    BIND(IF(NOT EXISTS {
          ?organization obo:BFO_0000051*/vivo:relatedBy  ?position2 
        }, 1/0, ?publication ) as ?publicationExt ) 
    }
  }
} GROUP BY ?year
	""" ;
        :uriBinding    "uri" ;
        :resultFormat  "JSON" .


:GrantsOverLast5YearsDistributor
        a              <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
        :actionName    "Collaboration report: grants over the last 5 years" ;
        :query         """
PREFIX vivo: <http://vivoweb.org/ontology/core#>
	PREFIX obo: <http://purl.obolibrary.org/obo/>
	PREFIX foaf: <http://xmlns.com/foaf/0.1/>
	PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
	SELECT (COUNT(?grantExt) as ?grantExtCount) (COUNT(?grantInt) as ?grantIntCount) ?year
	WHERE 
	{
	  SELECT DISTINCT ?grantInt ?grantExt ?year
	  WHERE {
	    {
	      SELECT ?targetYearStart ?targetYearEnd ?year
	      WHERE {
	        {
	          BIND (YEAR(NOW()) as ?currentYear)
	          BIND(?currentYear as ?year) 
	        }
	        UNION
	        {
	          BIND (YEAR(NOW()) as ?currentYear)
	          BIND(?currentYear -1 as ?year) 
	        }
	        UNION
	        {
	          BIND (YEAR(NOW()) as ?currentYear)
	          BIND(?currentYear -2 as ?year) 
	        }
	        UNION
	        {
	          BIND (YEAR(NOW()) as ?currentYear)
	          BIND(?currentYear -3 as ?year) 
	        }
	        UNION
	        {
	          BIND (YEAR(NOW()) as ?currentYear)
	          BIND(?currentYear -4 as ?year) 
	        }
	        BIND(STRDT(STR(?year) + '-12-31T23:59:59', xsd:dateTime) as ?targetYearEnd)
	        BIND(STRDT(STR(?year) + '-01-01T00:00:00', xsd:dateTime) as ?targetYearStart)
	      }
	    }
            OPTIONAL {
	    BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
	    ?organization a foaf:Organization .
	    ?organization obo:BFO_0000051*/vivo:relatedBy ?position1 .
	    ?position1 a vivo:Position .
	    ?position1 vivo:relates ?person1 .
	    ?person1 a foaf:Person .
	    ?person1 obo:RO_0000053/vivo:relatedBy ?grant .
	    ?grant a vivo:Grant .
	    ?person2 obo:RO_0000053/vivo:relatedBy ?grant .
	    ?person2 a foaf:Person .
	    FILTER(?person1 != ?person2)
	    ?position2 vivo:relates ?person2 .
	    ?position2 a vivo:Position .
	    ?grant vivo:dateTimeInterval ?dti .
	    ?dti vivo:start/vivo:dateTime ?startTime .
	    ?dti vivo:end/vivo:dateTime ?endTime .
	    FILTER (?startTime <= ?targetYearEnd)
	    FILTER (?endTime >= ?targetYearStart)
   		OPTIONAL {
	          ?position1 vivo:dateTimeInterval ?dti1 .
	          ?dti1 vivo:start/vivo:dateTime ?position1StartDT .
	          OPTIONAL {
	            ?dti1 vivo:end/vivo:dateTime ?position1EndDT .
	          }
	        }
        FILTER(!BOUND(?position1StartDT) || ?position1StartDT <= ?endTime)
        FILTER(!BOUND(?position1EndDT) || ?position1EndDT >= ?startTime)

        OPTIONAL {
          ?position2 vivo:dateTimeInterval ?dti2 .
          ?dti2 vivo:start/vivo:dateTime ?position2StartDT .
          OPTIONAL {
            ?dti2 vivo:end/vivo:dateTime ?position2EndDT .
          }
        }
        FILTER(!BOUND(?position2StartDT) || ?position2StartDT <= ?endTime)
        FILTER(!BOUND(?position2EndDT) || ?position2EndDT >= ?startTime)
    
	    BIND(IF(EXISTS { ?organization obo:BFO_0000051*/vivo:relatedBy ?position2 }, 1/0, ?grant ) as ?grantInt ) 
	    BIND(IF(NOT EXISTS { ?organization obo:BFO_0000051*/vivo:relatedBy ?position2 }, 1/0, ?grant ) as ?grantExt ) 
	  }
         }
	} GROUP BY ?year
	""" ;
        :uriBinding    "uri" ;
        :resultFormat  "JSON" .


:ResearchAreaPublicationsOverLast5YearsDistributor
        a              <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
        :actionName    "Collaboration report: research areas over the last 5 years" ;
        :query         """
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
	PREFIX bibo: <http://purl.org/ontology/bibo/>
	PREFIX vivo: <http://vivoweb.org/ontology/core#>
	PREFIX obo: <http://purl.obolibrary.org/obo/>
	PREFIX foaf: <http://xmlns.com/foaf/0.1/>
	PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
	SELECT ?label
	?countInt0 ?countExt0 
	?countInt1 ?countExt1 
	?countInt2 ?countExt2 
	?countInt3 ?countExt3 
	?countInt4 ?countExt4 
	WHERE {
	  {
	    SELECT 
	    ?concept
	    (COUNT(?publicationInt0) as ?countInt0)
	    (COUNT(?publicationExt0) as ?countExt0)
	    (COUNT(?publicationInt1) as ?countInt1)
	    (COUNT(?publicationExt1) as ?countExt1)
	    (COUNT(?publicationInt2) as ?countInt2)
	    (COUNT(?publicationExt2) as ?countExt2)
	    (COUNT(?publicationInt3) as ?countInt3)
	    (COUNT(?publicationExt3) as ?countExt3)
	    (COUNT(?publicationInt4) as ?countInt4)
	    (COUNT(?publicationExt4) as ?countExt4)
	    WHERE {
	      SELECT DISTINCT ?publicationInt0 ?publicationExt0 ?publicationInt1 ?publicationExt1 ?publicationInt2 ?publicationExt2 ?publicationInt3 ?publicationExt3 ?publicationInt4 ?publicationExt4 ?concept
	      WHERE {
	        BIND (YEAR(NOW()) as ?currentYear)
	        BIND(?currentYear as ?year0) 
	        BIND(?currentYear -1 as ?year1) 
	        BIND(?currentYear -2 as ?year2) 
	        BIND(?currentYear -3 as ?year3) 
	        BIND(?currentYear -4 as ?year4) 
	        BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
	        ?organization a foaf:Organization .
	        ?organization obo:BFO_0000051*/vivo:relatedBy ?position1 .
            ?position1 a vivo:Position .
            ?position1 vivo:relates ?person1 .
	        ?person1 a foaf:Person .
	        ?person1 vivo:relatedBy/vivo:relates ?publication .
            ?publication vivo:dateTimeValue/vivo:dateTime ?publicationDT .
	        ?publication vivo:hasSubjectArea ?concept .
	        ?concept a skos:Concept .
	        ?person2 vivo:relatedBy/vivo:relates ?publication .
	        ?person2 a foaf:Person .
   	        FILTER(?person1 != ?person2)
            ?position2 vivo:relates ?person2 .
            ?position2 a vivo:Position .
            OPTIONAL {
              ?position1 vivo:dateTimeInterval ?dti1 .
              ?dti1 vivo:start/vivo:dateTime ?position1StartDT .
              OPTIONAL {
                ?dti1 vivo:end/vivo:dateTime ?position1EndDT .
              }
            }
            FILTER(!BOUND(?position1StartDT) || ?position1StartDT <= ?publicationDT)
            FILTER(!BOUND(?position1EndDT) || ?position1EndDT >= ?publicationDT)

            OPTIONAL {
              ?position2 vivo:dateTimeInterval ?dti2 .
              ?dti2 vivo:start/vivo:dateTime ?position2StartDT .
              OPTIONAL {
                ?dti2 vivo:end/vivo:dateTime ?position2EndDT .
              }
            }
            FILTER(!BOUND(?position2StartDT) || ?position2StartDT <= ?publicationDT)
            FILTER(!BOUND(?position2EndDT) || ?position2EndDT >= ?publicationDT)
	        ?publication a ?publicationType .
	        VALUES ?publicationType {
	          bibo:Document    
	          bibo:Journal
	        }
	        
	        BIND(YEAR(?publicationDT) as ?pubYear)
	        BIND(IF( ?pubYear = ?year0 && EXISTS {?organization obo:BFO_0000051*/vivo:relatedBy ?position2 }, 1/0, ?publication ) as ?publicationInt0 ) 
	        BIND(IF( ?pubYear = ?year0 && NOT EXISTS {?organization obo:BFO_0000051*/vivo:relatedBy ?position2 }, 1/0, ?publication ) as ?publicationExt0 ) 
	        BIND(IF( ?pubYear = ?year1 && EXISTS {?organization obo:BFO_0000051*/vivo:relatedBy ?position2 }, 1/0, ?publication ) as ?publicationInt1 ) 
	        BIND(IF( ?pubYear = ?year1 && NOT EXISTS {?organization obo:BFO_0000051*/vivo:relatedBy ?position2 }, 1/0, ?publication ) as ?publicationExt1 ) 
	        BIND(IF( ?pubYear = ?year2 && EXISTS {?organization obo:BFO_0000051*/vivo:relatedBy ?position2 }, 1/0, ?publication ) as ?publicationInt2 ) 
	        BIND(IF( ?pubYear = ?year2 && NOT EXISTS {?organization obo:BFO_0000051*/vivo:relatedBy ?position2 }, 1/0, ?publication ) as ?publicationExt2 ) 
	        BIND(IF( ?pubYear = ?year3 && EXISTS {?organization obo:BFO_0000051*/vivo:relatedBy ?position2 }, 1/0, ?publication ) as ?publicationInt3 ) 
	        BIND(IF( ?pubYear = ?year3 && NOT EXISTS {?organization obo:BFO_0000051*/vivo:relatedBy ?position2 }, 1/0, ?publication ) as ?publicationExt3 ) 
	        BIND(IF( ?pubYear = ?year4 && EXISTS {?organization obo:BFO_0000051*/vivo:relatedBy ?position2 }, 1/0, ?publication ) as ?publicationInt4 ) 
	        BIND(IF( ?pubYear = ?year4 && NOT EXISTS {?organization obo:BFO_0000051*/vivo:relatedBy ?position2 }, 1/0, ?publication ) as ?publicationExt4 ) 
	      }
	    } GROUP BY ?concept
	  }
	  ?concept rdfs:label ?label .
	} ORDER BY DESC(?label)
	""" ;
        :uriBinding    "uri" ;
        :resultFormat  "JSON" .

:PersonsByGrantDistributor
        a              <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
        :actionName    "Organization metrics: persons by grant" ;
        :query         """
		PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
		PREFIX vivo: <http://vivoweb.org/ontology/core#>
		PREFIX obo: <http://purl.obolibrary.org/obo/>
		PREFIX foaf: <http://xmlns.com/foaf/0.1/>
		PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
		SELECT DISTINCT ?grantLabel ?personLabel ?g1 ?person ?g2
		WHERE {
		{
			SELECT DISTINCT ?g1 ?g2 ?grant ?grantLabel
			WHERE {
				{
					BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
					?organization a foaf:Organization .
					?organization obo:BFO_0000051*/vivo:relatedBy/vivo:relates ?person .
					?person a foaf:Person .
					?person obo:RO_0000053/vivo:relatedBy ?grant .
					?grant a vivo:Grant .
					?grant rdfs:label ?grantLabel .
					BIND(?grant as ?g1)
				}
				UNION {
					BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
					?organization a foaf:Organization .
					?organization obo:BFO_0000051*/vivo:relatedBy/vivo:relates ?person .
					?person a foaf:Person .
					?person obo:RO_0000053/vivo:relatedBy ?grant .
					?grant a vivo:Grant .
					BIND(?grant as ?g2)
				}
			} ORDER BY ?grant DESC(?g1)
		}
		OPTIONAL {
			FILTER(BOUND(?g2))
			FILTER(!BOUND(?g1))
			?person obo:RO_0000053/vivo:relatedBy ?g2 .
			?person a foaf:Person .
			BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
			?organization obo:BFO_0000051*/vivo:relatedBy/vivo:relates ?person .
			?organization a foaf:Organization .
			?person rdfs:label ?personLabel .
		}
		}
	""" ;
        :uriBinding    "uri" ;
        :resultFormat  "JSON" .

:OrganizationMetricsPersonMarkersDistributor
        a              <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
        :actionName    "Organization metrics: MAIN TABLE" ;
        :query         """
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
	PREFIX bibo: <http://purl.org/ontology/bibo/>
	PREFIX vivo: <http://vivoweb.org/ontology/core#>
	PREFIX obo: <http://purl.obolibrary.org/obo/>
	PREFIX foaf: <http://xmlns.com/foaf/0.1/>
	SELECT 
	?label 
	?orcid 
	?scopus 
	?researcher 
	?books 
	?articles 
	?academicArticles
	WHERE {
	  {
	    SELECT ?person 
	    (COUNT (?book) as ?books)
	    (COUNT (?article) as ?articles)
	    (COUNT (?academicArticle) as ?academicArticles)
	    WHERE {
	        {
	        SELECT DISTINCT ?person
	        WHERE {
	          BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
	          ?organization a foaf:Organization .
	          ?organization obo:BFO_0000051*/vivo:relatedBy/vivo:relates ?person .
	          ?person a foaf:Person .
	        }
	      }
	      ?person vivo:relatedBy/vivo:relates ?publication .
	      OPTIONAL {
	        ?publication a bibo:Book .
	        BIND(?publication as ?book)
	      }
	      OPTIONAL {
	        ?publication a bibo:Article .
	        FILTER NOT EXISTS { ?publication a bibo:AcademicArticle .}
	        BIND(?publication as ?article)
	      }
	      OPTIONAL {
	        ?publication a bibo:AcademicArticle .
	        BIND(?publication as ?academicArticle)
	      }
	    } GROUP BY ?person
	  }
	  ?person rdfs:label ?label .
	  BIND(IF(EXISTS {
	        ?person vivo:orcidId ?orcidId
	      }, "No", "Yes" ) as ?orcid ) 
	  BIND(IF(EXISTS {
	        ?person vivo:scopusId ?scopusId
	      }, "No", "Yes" ) as ?scopus ) 
	  BIND(IF(EXISTS {
	        ?person vivo:researcherId ?researcherId
	      }, "No", "Yes" ) as ?researcher ) 
	} ORDER BY ?label
	""" ;
        :uriBinding    "uri" ;
        :resultFormat  "JSON" .

:PersonsByResearchAreasDistributor
        a              <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
        :actionName    "Organization metrics: persons by research areas" ;
        :query         """
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
	PREFIX vivo: <http://vivoweb.org/ontology/core#>
	PREFIX obo: <http://purl.obolibrary.org/obo/>
	PREFIX foaf: <http://xmlns.com/foaf/0.1/>
	PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
	SELECT DISTINCT ?conceptLabel ?personLabel ?c1 ?person ?c2
	WHERE {
	  {
	    SELECT DISTINCT ?c1 ?c2 ?concept ?conceptLabel
	    WHERE {
	      {
	        BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
	        ?organization a foaf:Organization .
	        ?organization obo:BFO_0000051*/vivo:relatedBy/vivo:relates ?person .
	        ?person a foaf:Person .
	        ?person vivo:hasResearchArea ?concept .
	        ?concept a skos:Concept .
	        ?concept rdfs:label ?conceptLabel .
	        BIND(?concept as ?c1)
	      }
	      UNION {
	        BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
	        ?organization a foaf:Organization .
	        ?organization obo:BFO_0000051*/vivo:relatedBy/vivo:relates ?person .
	        ?person a foaf:Person .
	        ?person vivo:hasResearchArea ?concept .
	        ?concept a skos:Concept .
	        BIND(?concept as ?c2)
	      }
	    } ORDER BY ?concept DESC(?c1)
	  }
	  OPTIONAL {
	    FILTER(BOUND(?c2))
	    FILTER(!BOUND(?c1))
	    ?person vivo:hasResearchArea ?c2 .
	    ?person a foaf:Person .
	    BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
	    ?organization obo:BFO_0000051*/vivo:relatedBy/vivo:relates ?person .
	    ?organization a foaf:Organization .
	    ?person rdfs:label ?personLabel .
	  }
	}
	""" ;
        :uriBinding    "uri" ;
        :resultFormat  "JSON" .

:PersonsByPatentsDistributor
        a              <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
        :actionName    "Organization metrics: persons by patents" ;
        :query         """
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
	PREFIX vivo: <http://vivoweb.org/ontology/core#>
	PREFIX obo: <http://purl.obolibrary.org/obo/>
	PREFIX foaf: <http://xmlns.com/foaf/0.1/>
	PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
	PREFIX bibo: <http://purl.org/ontology/bibo/>
	SELECT DISTINCT ?patentLabel ?personLabel ?p1 ?person ?p2
	WHERE {
	  {
	    SELECT DISTINCT ?p1 ?p2 ?patent ?patentLabel
	    WHERE {
	      ?person vivo:relatedBy/vivo:relates ?patent .
	      {
	        BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
	        ?organization a foaf:Organization .
	        ?organization obo:BFO_0000051*/vivo:relatedBy/vivo:relates ?person .
	        ?person a foaf:Person .
	        ?person vivo:relatedBy/vivo:relates ?patent .
	        ?patent a bibo:Patent .
	        ?patent rdfs:label ?patentLabel .
	        BIND(?patent as ?p1)
	      }
	      UNION {
	        BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
	        ?organization a foaf:Organization .
	        ?organization obo:BFO_0000051*/vivo:relatedBy/vivo:relates ?person .
	        ?person a foaf:Person .
	        ?person vivo:relatedBy/vivo:relates ?patent .
	        ?patent a bibo:Patent .
	        BIND(?patent as ?p2)
	      }
	    } ORDER BY ?patent DESC(?p1)
	  }
	  OPTIONAL {
	    FILTER(BOUND(?p2))
	    FILTER(!BOUND(?p1))
	    ?person vivo:relatedBy/vivo:relates ?p2 .
	    ?person a foaf:Person .
	    BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
	    ?organization obo:BFO_0000051*/vivo:relatedBy/vivo:relates ?person .
	    ?organization a foaf:Organization .
	    ?person rdfs:label ?personLabel .
	  }
	}
	""" ;
        :uriBinding    "uri" ;
        :resultFormat  "JSON" .

:13b0bcc2-1ea9-4929-9476-6f6f6e43ae83
        a              <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
        :actionName    "Collaboration report: publications by countries over the last 5 years" ;
        :query         """
PREFIX bibo: <http://purl.org/ontology/bibo/>
PREFIX vivo: <http://vivoweb.org/ontology/core#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT  ?countryLabel ?countExt0 ?countExt1 ?countExt2 ?countExt3 ?countExt4
WHERE {
  {
    SELECT DISTINCT 
    (COUNT(?publicationExt0) as ?countExt0)
    (COUNT(?publicationExt1) as ?countExt1)
    (COUNT(?publicationExt2) as ?countExt2)
    (COUNT(?publicationExt3) as ?countExt3)
    (COUNT(?publicationExt4) as ?countExt4)
    ?country
    WHERE {
      BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
      BIND (YEAR(NOW()) as ?currentYear)
      BIND(?currentYear as ?year0) 
      BIND(?currentYear -1 as ?year1) 
      BIND(?currentYear -2 as ?year2) 
      BIND(?currentYear -3 as ?year3) 
      BIND(?currentYear -4 as ?year4) 
      ?organization a foaf:Organization .
      ?person1 a foaf:Person .
      ?organization obo:BFO_0000051*/vivo:relatedBy ?position1 .
      ?position1 a vivo:Position .
      ?position1 vivo:relates ?person1 .
      ?person1 vivo:relatedBy/vivo:relates ?publication .
      ?person2 vivo:relatedBy/vivo:relates ?publication .
      FILTER(?person1 != ?person2)
      ?person2 a foaf:Person .
      ?extOrg a foaf:Organization .
      ?extOrg obo:BFO_0000051*/vivo:relatedBy?position2 .
      ?position2 a vivo:Position .
      ?position2 vivo:relates ?person2 .
      FILTER NOT EXISTS {
        ?organization obo:BFO_0000051*/vivo:relatedBy/vivo:relates ?person2 
      }
      FILTER NOT EXISTS {
        ?parentOrg obo:BFO_0000051 ?extOrg .
      }
      
      FILTER(EXISTS {
          ?publication a  bibo:Document 
        } ||EXISTS {
          ?publication a  bibo:Journal 
        }
      )
      ?publication vivo:dateTimeValue/vivo:dateTime ?publicationDT .
      BIND(YEAR(?publicationDT) as ?pubYear)
      OPTIONAL {
        ?position1 vivo:dateTimeInterval ?dti1 .
        ?dti1 vivo:start/vivo:dateTime ?position1StartDT .
        OPTIONAL {
          ?dti1 vivo:end/vivo:dateTime ?position1EndDT .
        }
      }
      FILTER(!BOUND(?position1StartDT) || ?position1StartDT <= ?publicationDT)
      FILTER(!BOUND(?position1EndDT) || ?position1EndDT >= ?publicationDT)

      OPTIONAL {
        ?position2 vivo:dateTimeInterval ?dti2 .
        ?dti2 vivo:start/vivo:dateTime ?position2StartDT .
        OPTIONAL {
          ?dti2 vivo:end/vivo:dateTime ?position2EndDT .
        }
      }
      FILTER(!BOUND(?position2StartDT) || ?position2StartDT <= ?publicationDT)
      FILTER(!BOUND(?position2EndDT) || ?position2EndDT >= ?publicationDT)
      ?extOrg obo:RO_0001025/obo:BFO_0000050* ?country .
      ?country a vivo:Country .
      BIND(IF( ?pubYear = ?year0, 1/0, ?publication ) as ?publicationExt0 ) 
      BIND(IF( ?pubYear = ?year1, 1/0, ?publication ) as ?publicationExt1 ) 
      BIND(IF( ?pubYear = ?year2, 1/0, ?publication ) as ?publicationExt2 ) 
      BIND(IF( ?pubYear = ?year3, 1/0, ?publication ) as ?publicationExt3 ) 
      BIND(IF( ?pubYear = ?year4, 1/0, ?publication ) as ?publicationExt4 ) 
    } GROUP BY ?country 
  }
  ?country rdfs:label ?countryLabel .
} ORDER BY DESC(?countExt0)
""" ;
        :resultFormat  "JSON" ;
        :uriBinding    "uri" .

:31b1900c-e5aa-4fef-bf02-1fdbb5bcb874
        a              <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
        :actionName    "Collaboration report: publications by external organizations over the last 5 years" ;
        :query         """
PREFIX bibo: <http://purl.org/ontology/bibo/>
PREFIX vivo: <http://vivoweb.org/ontology/core#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT  ?extOrgLabel ?countExt0 ?countExt1 ?countExt2 ?countExt3 ?countExt4
WHERE {
  {
    SELECT DISTINCT 
    (COUNT(?publicationExt0) as ?countExt0)
    (COUNT(?publicationExt1) as ?countExt1)
    (COUNT(?publicationExt2) as ?countExt2)
    (COUNT(?publicationExt3) as ?countExt3)
    (COUNT(?publicationExt4) as ?countExt4)
    ?extOrg
    WHERE {
      BIND(COALESCE(?uri, <http://vivo.mydomain.edu/individual/n5513>) as ?organization)
      BIND (YEAR(NOW()) as ?currentYear)
      BIND(?currentYear as ?year0) 
      BIND(?currentYear -1 as ?year1) 
      BIND(?currentYear -2 as ?year2) 
      BIND(?currentYear -3 as ?year3) 
      BIND(?currentYear -4 as ?year4) 
      ?organization a foaf:Organization .
      ?person1 a foaf:Person .
      ?organization obo:BFO_0000051*/vivo:relatedBy ?position1 .
      ?position1 a vivo:Position .
      ?position1 vivo:relates ?person1 .
      ?person1 vivo:relatedBy/vivo:relates ?publication .
      ?person2 vivo:relatedBy/vivo:relates ?publication .
      FILTER(?person1 != ?person2)
      ?person2 a foaf:Person .
      ?extOrg a foaf:Organization .
      ?extOrg obo:BFO_0000051*/vivo:relatedBy?position2 .
      ?position2 a vivo:Position .
      ?position2 vivo:relates ?person2 .
      FILTER NOT EXISTS {
        ?organization obo:BFO_0000051*/vivo:relatedBy/vivo:relates ?person2 
      }
      FILTER NOT EXISTS {
        ?parentOrg obo:BFO_0000051 ?extOrg .
      }
      FILTER(EXISTS {
          ?publication a  bibo:Document 
        } ||EXISTS {
          ?publication a  bibo:Journal 
        }
      )
      ?publication vivo:dateTimeValue/vivo:dateTime ?publicationDT .
      BIND(YEAR(?publicationDT) as ?pubYear)
      OPTIONAL {
        ?position1 vivo:dateTimeInterval ?dti1 .
        ?dti1 vivo:start/vivo:dateTime ?position1StartDT .
        OPTIONAL {
          ?dti1 vivo:end/vivo:dateTime ?position1EndDT .
        }
      }
      FILTER(!BOUND(?position1StartDT) || ?position1StartDT <= ?publicationDT)
      FILTER(!BOUND(?position1EndDT) || ?position1EndDT >= ?publicationDT)

      OPTIONAL {
        ?position2 vivo:dateTimeInterval ?dti2 .
        ?dti2 vivo:start/vivo:dateTime ?position2StartDT .
        OPTIONAL {
          ?dti2 vivo:end/vivo:dateTime ?position2EndDT .
        }
      }
      FILTER(!BOUND(?position2StartDT) || ?position2StartDT <= ?publicationDT)
      FILTER(!BOUND(?position2EndDT) || ?position2EndDT >= ?publicationDT)
      BIND(IF( ?pubYear = ?year0, 1/0, ?publication ) as ?publicationExt0 ) 
      BIND(IF( ?pubYear = ?year1, 1/0, ?publication ) as ?publicationExt1 ) 
      BIND(IF( ?pubYear = ?year2, 1/0, ?publication ) as ?publicationExt2 ) 
      BIND(IF( ?pubYear = ?year3, 1/0, ?publication ) as ?publicationExt3 ) 
      BIND(IF( ?pubYear = ?year4, 1/0, ?publication ) as ?publicationExt4 ) 
    } GROUP BY ?extOrg 
  }
  ?extOrg rdfs:label ?extOrgLabel .
} ORDER BY DESC(?countExt0)
""" ;
        :resultFormat  "JSON" ;
        :uriBinding    "uri" .
